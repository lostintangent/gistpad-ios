{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "typeRoots": ["../../../../documint/node_modules/@types"],
    "paths": {
      "@lostintangent/documint": ["../../../../documint/src/index.ts"],
      "@/*": ["../../../../documint/src/*"],
      "@macros/*": ["../../../../documint/scripts/build/macros/*"],
      "react": ["../../../../documint/node_modules/@types/react"],
      "react/*": ["../../../../documint/node_modules/@types/react/*"],
      "react-dom/*": ["../../../../documint/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["main.tsx", "build.ts", "fidelity.ts"]
}
