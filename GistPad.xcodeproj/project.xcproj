{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": ".",
    }, {
      "kind": "remote",
      "repository": "https://github.com/supabase/supabase-swift.git",
      "version": {
        "version": "2.55.4",
      },
    },
  ],
  "files": [
    {
      "kind": "group",
      "path": "Sources",
      "children": [
        {
          "kind": "folder",
          "path": "App",
          "target-membership": [
            "GistPad",
          ],
          "membership-exceptions": [
            {
              "target": "GistPad",
              "exclusions": [
                "Info.plist",
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "Extensions",
          "children": [
            {
              "kind": "folder",
              "path": "Widgets",
              "target-membership": [
                "GistPadWidgets",
              ],
              "membership-exceptions": [
                {
                  "target": "GistPadWidgets",
                  "exclusions": [
                    "Info.plist",
                  ],
                },
              ],
            },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Tests",
      "children": [
        { "kind": "folder", "path": "App", "target-membership": [ "GistPadTests" ] },
        { "kind": "folder", "path": "UI", "target-membership": [ "GistPadUITests" ] },
      ],
    },
    { "path": "Configuration/Public.xcconfig" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/GistPad.app", "id": "A00000000000000000000004", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/GistPadTests.xctest", "id": "A00000000000000000000005", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/GistPadUITests.xctest", "id": "F80000000000000000000004", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/GistPadWidgets.appex", "id": "B40000000000000000000004", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "GistPad/copy/Embed App Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "GistPad",
      "id": "A00000000000000000000020",
      "product": "Products/GistPad.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "RHFNBL7EG4",
      "specialized-configurations": [
        { "name": "Debug", "file": "Public.xcconfig" },
        { "name": "Release", "file": "Public.xcconfig" },
      ],
      "dependencies": [
        "GistPadWidgets",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed App Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": ".",
          "product-name": "Accent",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Comments",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Editor",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Intelligence",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Model",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Platform",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Preview",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Screens",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Store",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "Sources/App/GistPad.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "RHFNBL7EG4",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Sources/App/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "GistPad",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.gistpad.GistPad",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
      "name": "GistPadTests",
      "id": "A00000000000000000000030",
      "product": "Products/GistPadTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "GistPad",
      "dependencies": [
        "GistPad",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": ".",
          "product-name": "Accent",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Comments",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Editor",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Intelligence",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Model",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Platform",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Preview",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Screens",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Store",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "supabase-swift",
          "product-name": "Auth",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "RHFNBL7EG4",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.gistpad.GistPadTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TARGETED_DEVICE_FAMILY": "1",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/GistPad.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/GistPad",
      },
    }, {
      "name": "GistPadUITests",
      "id": "F80000000000000000000020",
      "product": "Products/GistPadUITests.xctest",
      "product-type": "bundle.ui-testing",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "RHFNBL7EG4",
      "test-host-target": "GistPad",
      "dependencies": [
        "GistPad",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "RHFNBL7EG4",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.gistpad.GistPadUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TARGETED_DEVICE_FAMILY": "1",
        "TEST_TARGET_NAME": "GistPad",
      },
    }, {
      "name": "GistPadWidgets",
      "id": "B40000000000000000000020",
      "product": "Products/GistPadWidgets.appex",
      "product-type": "app-extension",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "RHFNBL7EG4",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": ".",
          "product-name": "Platform",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": ".",
          "product-name": "Store",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Sources/Extensions/Widgets/GistPadWidgets.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "RHFNBL7EG4",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Sources/Extensions/Widgets/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "GistPad Today",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.gistpad.GistPad.Widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
    "CURRENT_PROJECT_VERSION": "44",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
    "MARKETING_VERSION": "1.1.1",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_VERSION": "6.0",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
  "last-upgrade": "27.1",
}
