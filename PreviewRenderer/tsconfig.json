{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["../../gistpad.dev/src/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
